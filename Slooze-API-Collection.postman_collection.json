{
  "info": {
    "name": "Slooze Food Ordering API",
    "description": "Complete GraphQL API collection for Slooze Food Ordering App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/graphql" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Nick Fury (Admin)",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json(); if(r.data) pm.collectionVariables.set('token', r.data.login.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}",
            "body": { "mode": "raw", "raw": "{\"query\":\"mutation { login(email: \\\"nick@slooze.com\\\", password: \\\"password123\\\") { token user { id name email role country } } }\"}" }
          }
        },
        {
          "name": "Login - Captain Marvel (Manager-India)",
